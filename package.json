{
  "name": "@whitetrefoil/jsx-sp-events",
  "version": "0.10.0",
  "description": "A tiny helper to reduce codes about ev.preventDefault() & ev.stopPropagation()",
  "keywords": [
    "jsx",
    "events",
    "react",
    "preact"
  ],
  "files": [
    "lib",
    "src",
    "tests"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/main.js"
  },
  "scripts": {
    "prepack": "yarn build",
    "build": "rimraf lib && tsc -p src/tsconfig.json --noEmit false",
    "publish": "echo \"Done publishing, don't forget to:\n  1. **dist-tag** your channel in npm.\n  2. bump version in package.json\nGood luck with the publish ;)\"",
    "test": "rimraf test_results && vitest run && eslint src tests",
    "watch": "rimraf lib && tsc -p src/tsconfig.json --noEmit false -w"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whitetrefoil/jsx-sp-events.git"
  },
  "author": "WhiteTrefoil <whitetrefoil@gmail.com>",
  "license": "Unlicense",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.2.14",
    "@types/rimraf": "^4.0.5",
    "@typescript/native-preview": "^7.0.0-dev.20260409.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@whitetrefoil/eslint-config": "^12.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-n": "^17.24.0",
    "rimraf": "^6.1.3",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "type-fest": "^5.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
